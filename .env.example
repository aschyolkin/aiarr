# Copy to .env and keep permissions 0600. Generate a random >=24-character key.
MAE_API_KEY=
MAE_DRY_RUN=true
MAE_STATE_HOST=/mnt/data/apps/aiarr-state
MAE_UID=3000
MAE_GID=3000
MAE_QBIT_URL=http://10.110.111.2:30024
MAE_QBIT_USERNAME=
MAE_QBIT_PASSWORD=
MAE_JELLYFIN_URL=http://10.110.111.2:30013
MAE_JELLYFIN_KEY=
MAE_SEERR_URL=http://10.110.111.2:30357
MAE_SEERR_KEY=
MAE_DEEPSEEK_KEY=
MAE_DEEPSEEK_MODEL=deepseek-flash
MAE_PROVIDERS=[]
# Example (operator supplies gateway indexer ID/key):
# MAE_PROVIDERS=[{"name":"rutracker","protocol":"torznab","url":"http://10.110.111.2:30050/INDEXER_ID/api","trusted_gateway":true,"api_key":""}]
# Anonymous direct adapters. Enable only after a dry-run health/search check.
# They use no account cookie and intentionally do not select source mirrors.
# MAE_PROVIDERS=[{"name":"rutor","protocol":"rutor","url":"https://rutor.info","source_host":"rutor.info","details_adapter":"rutor"},{"name":"nnmclub","protocol":"nnmclub","url":"https://nnmclub.to","encoding":"windows-1251"}]
# If this NAS deliberately resolves an exact source through its own Fake-IP proxy,
# add "trusted_source":true only to that source after verifying the route.
