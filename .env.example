# Copy to .env and keep permissions 0600, or just run ./install.sh. Generate a random >=24-character key.
MAE_API_KEY=
MAE_DRY_RUN=true
# One filesystem holding downloads/{films,serials} and the libraries films/ and serials/.
MAE_STORE_HOST=/srv/media
# Persistent directory for the database and settings, owned by MAE_UID:MAE_GID.
MAE_STATE_HOST=./state
MAE_UID=3000
MAE_GID=3000
# Where the API listens on the host. Use 0.0.0.0 so Seerr in another container can reach it.
MAE_BIND=127.0.0.1
MAE_PORT=30280
# Services are reached from inside a container: use the host's address or host.docker.internal.
MAE_QBIT_URL=http://host.docker.internal:8080
MAE_QBIT_USERNAME=
MAE_QBIT_PASSWORD=
MAE_JELLYFIN_URL=http://host.docker.internal:8096
MAE_JELLYFIN_KEY=
MAE_SEERR_URL=http://host.docker.internal:5055
MAE_SEERR_KEY=
MAE_DEEPSEEK_KEY=
MAE_DEEPSEEK_MODEL=deepseek-flash
MAE_DEEPSEEK_DAILY_CALLS=20
MAE_DEEPSEEK_DAILY_TOKENS=200000
MAE_DEEPSEEK_REQUEST_CALLS=6
MAE_DEEPSEEK_REQUEST_TOKENS=60000
MAE_PROVIDERS=[]
# Sources are normally added in the admin page. Example of one set in the environment
# (a Torznab indexer behind Prowlarr; the operator supplies its ID and key):
# MAE_PROVIDERS=[{"name":"rutracker","protocol":"torznab","url":"http://prowlarr:9696/INDEXER_ID/api","trusted_gateway":true,"api_key":""}]
# Anonymous direct adapters. Enable only after a dry-run health/search check.
# They use no account cookie and intentionally do not select source mirrors.
# MAE_PROVIDERS=[{"name":"rutor","protocol":"rutor","url":"https://rutor.info","source_host":"rutor.info","details_adapter":"rutor"},{"name":"nnmclub","protocol":"nnmclub","url":"https://nnmclub.to","encoding":"windows-1251"}]
# If your network deliberately resolves an exact source through its own Fake-IP proxy,
# add "trusted_source":true only to that source after verifying the route.
